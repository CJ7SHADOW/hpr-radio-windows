<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The 10.0.19041 Windows SDK gives access to the Windows media controls (SMTC). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HprRadio</RootNamespace>
    <AssemblyName>HprRadio</AssemblyName>
    <ApplicationIcon>Assets\hpr.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!-- English only: skip the translated .NET/WPF error messages (13 languages). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>1.0.3</Version>
    <Product>HPR Radio</Product>
    <Company>KG4BHR</Company>
    <Description>Unofficial desktop player for Heartland Public Radio</Description>
    <Copyright>Programming and streams belong to Heartland Public Radio, Inc.</Copyright>

    <!-- Windows 11 "Fluent" look for the standard controls (Application.ThemeMode). -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- VLC's engine plays the streams: it handles Shoutcast/Icecast quirks, gives song
         titles (ICY), and can run with a silent audio output for automated tests. -->
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\channels.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\hpr.ico" />
    <Resource Include="Assets\logo-256.png" />
  </ItemGroup>

</Project>
